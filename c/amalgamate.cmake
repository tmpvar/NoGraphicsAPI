# Concatenates c/src modules into the single header c/gpu.h.
# Usage: cmake -DOUTPUT=<path/to/gpu.h> -P c/amalgamate.cmake   (OUTPUT defaults to c/gpu.h)
set(src "${CMAKE_CURRENT_LIST_DIR}/src")
if(NOT OUTPUT)
    set(OUTPUT "${CMAKE_CURRENT_LIST_DIR}/gpu.h")
endif()
set(api gpu_api.h)
set(impl gpu_internal.h gpu_common.c gpu_loader.c gpu_device.c gpu_swapchain.c gpu_resources.c gpu_pso.c gpu_commands.c gpu_utility.c)

function(gpu_append_module name)
    file(READ "${src}/${name}" text)
    # Drop the module-local includes of sibling headers; the amalgamation already contains them.
    string(REGEX REPLACE "(^|\n)#include \"gpu_[a-z_]+\.[ch]\"[^\n]*" "\\1" text "${text}")
    string(LENGTH "${name}" name_length)
    math(EXPR dash_count "111 - ${name_length}")
    string(REPEAT "-" ${dash_count} dashes)
    set(gpu_output "${gpu_output}// ---- ${name} ${dashes}\n${text}\n" PARENT_SCOPE)
endfunction()

set(gpu_output "")
foreach(name IN LISTS api)
    gpu_append_module(${name})
endforeach()
string(APPEND gpu_output "\n#if defined(GPU_IMPLEMENTATION)\n\n")
foreach(name IN LISTS impl)
    if(EXISTS "${src}/${name}")
        gpu_append_module(${name})
    endif()
endforeach()
string(APPEND gpu_output "\n#endif // GPU_IMPLEMENTATION\n")
file(WRITE "${OUTPUT}" "${gpu_output}")
message(STATUS "wrote ${OUTPUT}")
